    # 1. FastAPI REST API, Swagger Docs, WebSockets, Uploads
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /docs* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /openapi.json* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /redoc* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /ws/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /uploads/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /health {
        reverse_proxy 127.0.0.1:8000
    }

    # 2. Reflex Frontend & State Engine (WebSockets, Event handlers, Pages)
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
