# ==============================================================================
# ForFriend Backend Environment Variables
# ==============================================================================

# Database SQLite Async (lưu tại thư mục backend/)
DATABASE_URL=sqlite+aiosqlite:///./forfriend.db

# JWT Secret Key & Token Expiry
JWT_SECRET_KEY=super-secret-key-forfriend-dev-only-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LiveKit Cloud (Free tier)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud

# Upload Storage (Local)
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=5242880
MAX_CV_SIZE=10485760

# CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
